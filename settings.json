{
  "effortLevel": "high",
  "theme": "auto",
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Glob",
      "Grep",
      "Read",
      "Bash(npm run check-types)",
      "Bash(npm run lint *)",
      "Bash(npx eslint *)",
      "Bash(npx stylelint *)",
      "Bash(npx jest *)",
      "Bash(npm test *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(npm run build)",
      "Bash(npm run codegen)",
      "mcp__ide__getDiagnostics"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-dangerous-git.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/format-staged.sh",
            "if": "Bash(git commit*)",
            "statusMessage": "Formatting staged files before commit",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
